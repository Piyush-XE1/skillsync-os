<?xml version="1.0" encoding="utf-8"?>
<!-- A premium paper surface: warm stock, hairline deckle edge, quiet depth.
     No blur, no glass, no decoration competing with the writing. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="2dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#5C000000" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#F1E8D7" />
            <stroke android:width="1dp" android:color="#D9CDB7" />
            <corners android:radius="6dp" />
            <padding
                android:bottom="10dp"
                android:left="14dp"
                android:right="14dp"
                android:top="10dp" />
        </shape>
    </item>
</layer-list>
