<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:letterSpacing="0.14"
        android:textAllCaps="true"
        android:textColor="@color/widgetAccent"
        android:textSize="9sp"
        android:text="Quick capture" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/qa_task"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:background="@drawable/widget_pill"
            android:textColor="@color/widgetText"
            android:textSize="11sp"
            android:text="＋ Task" />

        <TextView
            android:id="@+id/qa_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:background="@drawable/widget_pill"
            android:textColor="@color/widgetText"
            android:textSize="11sp"
            android:text="＋ Note" />

        <TextView
            android:id="@+id/qa_habit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:background="@drawable/widget_pill"
            android:textColor="@color/widgetText"
            android:textSize="11sp"
            android:text="＋ Habit" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/qa_focus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:background="@drawable/widget_pill_accent"
            android:textColor="@color/widgetAccent"
            android:textSize="11sp"
            android:text="Focus" />

        <TextView
            android:id="@+id/qa_plan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:background="@drawable/widget_pill"
            android:textColor="@color/widgetText"
            android:textSize="11sp"
            android:text="Planner" />

        <TextView
            android:id="@+id/qa_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:background="@drawable/widget_pill"
            android:textColor="@color/widgetText"
            android:textSize="11sp"
            android:text="Analytics" />
    </LinearLayout>
</LinearLayout>
