<?xml version="1.0" encoding="utf-8"?>
<!-- A small sheet that opens straight from the Spend widget to log any amount. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:textAllCaps="true"
        android:textColor="@color/widgetAccent"
        android:textSize="9sp"
        android:text="Log an expense" />

    <EditText
        android:id="@+id/expense_amount"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_surface"
        android:hint="0"
        android:inputType="numberDecimal"
        android:imeOptions="actionDone"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:textColor="@color/widgetText"
        android:textColorHint="@color/widgetFaint"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cat_food"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/widget_pill"
            android:textColor="@color/widgetText"
            android:textSize="11.5sp"
            android:text="Food" />

        <TextView
            android:id="@+id/cat_transit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/widget_pill"
            android:textColor="@color/widgetText"
            android:textSize="11.5sp"
            android:text="Transit" />

        <TextView
            android:id="@+id/cat_study"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/widget_pill"
            android:textColor="@color/widgetText"
            android:textSize="11.5sp"
            android:text="Study" />

        <TextView
            android:id="@+id/cat_other"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/widget_pill"
            android:textColor="@color/widgetText"
            android:textSize="11.5sp"
            android:text="Other" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/expense_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/widget_pill"
            android:textColor="@color/widgetMuted"
            android:textSize="12.5sp"
            android:text="Cancel" />

        <TextView
            android:id="@+id/expense_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:layout_marginLeft="8dp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/widget_pill_accent"
            android:textColor="@color/widgetAccent"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:text="Save spend" />
    </LinearLayout>
</LinearLayout>
