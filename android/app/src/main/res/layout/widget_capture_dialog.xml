<?xml version="1.0" encoding="utf-8"?>
<!-- One sheet, two modes: a quick note, or a task for today. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="18dp">

    <TextView
        android:id="@+id/capture_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:textAllCaps="true"
        android:textColor="@color/widgetAccent"
        android:textSize="9sp"
        android:text="New note" />

    <EditText
        android:id="@+id/capture_title_field"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_surface"
        android:hint="Title"
        android:inputType="textCapSentences"
        android:imeOptions="actionNext"
        android:maxLength="120"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:textColor="@color/widgetText"
        android:textColorHint="@color/widgetFaint"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/capture_body_field"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_surface"
        android:gravity="top|start"
        android:hint="Write it down…"
        android:inputType="textMultiLine|textCapSentences"
        android:padding="14dp"
        android:textColor="@color/widgetText"
        android:textColorHint="@color/widgetFaint"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/capture_time_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/capture_time"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/widget_surface"
            android:hint="Time · 18:30"
            android:inputType="datetime"
            android:maxLength="5"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@color/widgetText"
            android:textColorHint="@color/widgetFaint"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/capture_prio"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:background="@drawable/widget_pill"
            android:textColor="@color/widgetText"
            android:textSize="11.5sp"
            android:text="Medium" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/capture_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/widget_pill"
            android:textColor="@color/widgetMuted"
            android:textSize="12.5sp"
            android:text="Cancel" />

        <TextView
            android:id="@+id/capture_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:layout_marginLeft="8dp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/widget_pill_accent"
            android:textColor="@color/widgetAccent"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:text="Save note" />
    </LinearLayout>
</LinearLayout>
