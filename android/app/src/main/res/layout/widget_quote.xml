<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_eyebrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:letterSpacing="0.14"
            android:textAllCaps="true"
            android:textColor="@color/widgetAccent"
            android:textSize="9sp"
            android:text="Daily perspective" />

        <TextView
            android:id="@+id/widget_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widgetMuted"
            android:textSize="9sp"
            android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:maxLines="4"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/widgetText"
        android:textSize="14sp"
        android:textStyle="italic"
        android:text="" />

    <TextView
        android:id="@+id/widget_quote_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:singleLine="true"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:textColor="@color/widgetMuted"
        android:textSize="9sp"
        android:text="" />
</LinearLayout>
