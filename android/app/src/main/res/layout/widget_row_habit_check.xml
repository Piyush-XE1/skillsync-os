<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habit_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    android:background="@drawable/widget_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="7dp">

    <ImageView
        android:id="@+id/habit_row_mark"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="Habit state"
        android:src="@drawable/widget_habit_box" />

    <TextView
        android:id="@+id/habit_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widgetText"
        android:textSize="10.5sp" />

    <TextView
        android:id="@+id/habit_row_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textColor="@color/widgetMuted"
        android:textSize="8sp" />
</LinearLayout>
